generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id             String              @id @default(uuid())
  name           String
  cpf            String              @unique
  email          String              @unique
  password       String
  firstAccess    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  status         AdminStatus         @default(ACTIVE)
  passwordResets PasswordResetCode[]

  @@index([name])
  @@index([status])
  @@map("admins")
}

model Order {
  id             String   @id
  uuid           String   @default(uuid())
  client_id      String
  status         String   @default("PROCESS")
  code           Int
  type           String
  document       String
  report_id      String
  report_name    String
  duration       Int
  source         String
  transaction_id String
  origin         String   @default("API")
  ip             String
  external_id    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([id, client_id, document, code, ip])
  @@map("orders")
}

model Company {
  id                     String        @id @default(uuid())
  cnpj                   String
  name                   String
  operator_SPC           String?
  operator_SPC_password  String?
  limit_consults_daily   Int           @default(0)
  limit_consults_monthly Int           @default(0)
  status                 CompanyStatus @default(ACTIVE)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  users                  CompanyUser[]

  @@index([cnpj])
  @@index([name])
  @@index([status])
  @@map("companies")
}

model User {
  id             String              @id @default(uuid())
  user           String?             @unique
  cpf            String
  name           String
  password       String
  firstAccess    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  email          String?             @unique
  phone          String              @unique
  companies      CompanyUser[]
  passwordResets PasswordResetCode[]

  @@index([user])
  @@index([cpf])
  @@index([name])
  @@map("users")
}

enum PasswordResetTarget {
  ADMIN
  USER
}

model PasswordResetCode {
  id                  String              @id @default(uuid())
  adminId             String?
  userId              String?
  target              PasswordResetTarget
  code                String
  resetToken          String?             @unique
  codeExpiresAt       DateTime
  resetTokenExpiresAt DateTime?
  attempts            Int                 @default(0)
  usedAt              DateTime?
  createdAt           DateTime            @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([adminId, codeExpiresAt])
  @@index([userId, codeExpiresAt])
  @@index([target, createdAt])
  @@map("password_reset_codes")
}

model CompanyUser {
  id        String            @id @default(uuid())
  companyId String
  userId    String            @map("operatorId")
  role      UserRole          @default(USER)
  status    UserCompanyStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("company_users")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum UserRole {
  ADMIN
  USER  @map("OPERATOR")

  @@map("OperatorRole")
}

enum UserCompanyStatus {
  ACTIVE
  INACTIVE
  DELETED

  @@map("OperatorCompanyStatus")
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  DELETED

  @@map("UserStatus")
}
