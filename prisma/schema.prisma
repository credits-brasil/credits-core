generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id             String              @id @default(uuid())
  name           String
  cpf            String              @unique
  email          String              @unique
  password       String
  firstAccess    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  status         AdminStatus         @default(ACTIVE)
  passwordResets PasswordResetCode[]

  @@index([name])
  @@index([status])
  @@map("admins")
}

model Order {
  id           String       @id @default(uuid())
  user_id      String
  user_name    String
  company_id   String
  company_name String
  product_name String
  typeDocument TypeDocument
  document     String
  duration     Int
  inputs       Json
  origin       TypeOrigin
  ip           String
  host         String
  status       StatusOrder   @default(PROCESS)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("orders")
}

model SpcInput {
  id           String       @id @default(uuid())
  code         String
  label        String
  typeDocument TypeDocument
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([code, typeDocument])
  @@index([typeDocument, active])
  @@map("spc_inputs")
}

model Company {
  id                     String        @id @default(uuid())
  cnpj                   String
  name                   String
  operator_SPC           String?
  operator_SPC_password  String?
  limit_consults_daily   Int           @default(0)
  limit_consults_monthly Int           @default(0)
  status                 CompanyStatus @default(ACTIVE)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  users                  CompanyUser[]

  @@index([cnpj])
  @@index([name])
  @@index([status])
  @@map("companies")
}

model User {
  id             String              @id @default(uuid())
  user           String?             @unique
  cpf            String
  name           String
  password       String
  firstAccess    Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  email          String?             @unique
  phone          String              @unique
  companies      CompanyUser[]
  passwordResets PasswordResetCode[]

  @@index([user])
  @@index([cpf])
  @@index([name])
  @@map("users")
}

model Session {
  id               String        @id @default(uuid())
  kind             SessionKind
  userId           String?
  adminId          String?
  accessTokenHash  String        @unique
  refreshTokenHash String        @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime      @default(now())
  revokedAt        DateTime?

  @@index([userId])
  @@index([adminId])
  @@index([refreshExpiresAt])
  @@map("sessions")
}

enum PasswordResetTarget {
  ADMIN
  USER
}

model PasswordResetCode {
  id                  String              @id @default(uuid())
  adminId             String?
  admin               Admin?              @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  target              PasswordResetTarget
  code                String
  resetToken          String?             @unique
  codeExpiresAt       DateTime
  resetTokenExpiresAt DateTime?
  attempts            Int                 @default(0)
  usedAt              DateTime?
  createdAt           DateTime            @default(now())

  @@index([adminId, codeExpiresAt])
  @@index([userId, codeExpiresAt])
  @@index([target, createdAt])
  @@map("password_reset_codes")
}

model CompanyUser {
  id        String            @id @default(uuid())
  companyId String
  userId    String            @map("operatorId")
  role      UserRole          @default(USER)
  status    UserCompanyStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("company_users")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum UserRole {
  ADMIN
  USER
}

enum UserCompanyStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum TypeDocument {
  CPF
  CNPJ
}

enum TypeOrigin {
  API
  WEB
}
enum StatusOrder {
  PROCESS
  SUCCESS
  FAILED
}

enum SessionKind {
  USER
  ADMIN
}