{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "reset": "rm -rf node_modules && rm -rf coverage && rm -rf package-lock.json && rm -rf yarn.lock && yarn",
    "dev": "tsx watch -r tsconfig-paths/register src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testPathPattern='index'",
    "test:ci": "jest --ci",
    "prepare": "husky",
    "typecheck": "tsc",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:generate": "npx prisma generate",
    "lint": "eslint",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint --fix",
    "pre-commit": "npm run lint:staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "tsconfig-paths": "^4.2.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/xml2js": "^0.4.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint:fix",
      "git add ."
    ]
  }
}
